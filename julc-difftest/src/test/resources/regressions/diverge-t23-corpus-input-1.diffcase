import java.math.BigInteger;
import org.julclang.core.types.JulcList;

public class Probe {
    public static BigInteger m(BigInteger a, BigInteger b, JulcList<BigInteger> xs) {
        BigInteger v0 = a;
        BigInteger v1 = b;
        for (var x0 : xs) {
            if (x0.compareTo(b) < 0) { v0 = v0.add(BigInteger.valueOf(1)); } else { v1 = v1.add(x0); }
            if (x0.compareTo(b) > 0) { break; }
        }
        return v0.add(v1.multiply(BigInteger.valueOf(3)));
    }
}
