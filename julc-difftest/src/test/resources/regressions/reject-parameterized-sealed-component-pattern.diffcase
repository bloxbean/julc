format: 2
name: a record pattern on a parameterized sealed component
class: Probe
method: m
arg: 05
expect: REJECT JULC0076
note: ADR-067 D3 (F14): legal Java (5).
note: ADR-067 M1 (interim): the not-exhaustive rejection is now coded, JULC0005; record patterns are still dropped until M2a/M2b, which set the final verdict. REJECT none at the base.
note: ADR-067 M1 review (F35, interim): record-pattern labels are rejected with JULC0076 until M2a lowers them, so no label is dropped silently; M2a/M2b set the final verdict. Expectation before: REJECT JULC0005.
---
import java.math.BigInteger;

public class Probe {
    sealed interface G<X> permits GC, GD {}
    record GC(BigInteger c) implements G<String> {}
    record GD(BigInteger d) implements G<BigInteger> {}
    sealed interface H permits PW, PZ {}
    record PW(G<BigInteger> g) implements H {}
    record PZ(BigInteger z) implements H {}

    public static BigInteger m(BigInteger a) {
        H h = new PW(new GD(a));
        return switch (h) {
            case PW(GD(var d)) -> d;
            case PZ(var z) -> z;
        };
    }
}
