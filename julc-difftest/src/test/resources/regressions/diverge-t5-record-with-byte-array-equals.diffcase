name: equals of a record with a byte[] component (T5)
class: Probe
method: m
arg: 420102
arg: 420102
expect: DIVERGE T5 Value/Value
---
import java.math.BigInteger;
import org.julclang.core.types.JulcList;

public class Probe {
    record Holder(byte[] hash) {}

    public static boolean m(byte[] a, byte[] b) {
        return new Holder(a).equals(new Holder(b));
    }
}
