format: 2
name: a pattern naming a nested sealed interface (M4)
class: Probe
method: m
arg: 05
expect: REJECT JULC0109
note: ADR-067 M4: out of scope.
note: ADR-068 M6: on the only frontend, javac, REJECT JULC0109; the JavaParser frontend answered REJECT none.
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, U {}
    sealed interface U extends S permits B, C {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements U {}
    record C(BigInteger v) implements U {}

    public static BigInteger m(BigInteger a) {
        S s = new C(a);
        return switch (s) {
            case A x -> BigInteger.ONE;
            case U q -> BigInteger.TWO;
        };
    }
}
