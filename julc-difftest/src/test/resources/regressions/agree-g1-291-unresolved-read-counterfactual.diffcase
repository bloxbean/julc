import java.math.BigInteger;
import org.julclang.core.types.JulcList;
import org.julclang.stdlib.Builtins;

public class Probe {
    record R1(BigInteger w, BigInteger v) {}
    sealed interface S0 permits B0, A0 {}
    record B0(BigInteger v) implements S0 {}
    record A0() implements S0 {}
    sealed interface S1 permits B1, C1, A1 {}
    record B1(B0 v, R1 p, R1 w) implements S1 {}
    record C1(R1 f, R1 p) implements S1 {}
    record A1(B0 p) implements S1 {}
    record R0(BigInteger v, BigInteger w) {}

    static final R0 v = new R0(BigInteger.valueOf(-5), BigInteger.valueOf(-5));

    static BigInteger t(String k, BigInteger v) {
        return Builtins.unIData(Builtins.trace(k, Builtins.iData(v)));
    }

    static BigInteger fail(BigInteger z) {
        return Builtins.unIData(Builtins.error());
    }

    public static BigInteger m(BigInteger a, BigInteger b, JulcList<BigInteger> xs, A0 w, B1 w1) {
        S1 f = w1;
        BigInteger f1 = switch (f) {
            case B1 x -> v.w();
            default -> {
                BigInteger v2 = BigInteger.valueOf(-5);
                BigInteger v1 = BigInteger.valueOf(-5);
                long i0 = 0;
                while (i0 < 0) {
                    v1 = BigInteger.valueOf(-5);
                    i0 = i0 + 1;
                }
                yield BigInteger.valueOf(-5);
            }
        };
        return v.v();
    }
}
