format: 3
name: a guard that introduces a pattern variable (G12)
class: Probe
method: m
tag: Probe$C Probe$T 0
tag: Probe$D Probe$T 1
tag: Probe$P Probe$U 0
tag: Probe$Q Probe$U 1
arg: 07
expect: REJECT JULC0074
note: ADR-067 G12: legal Java (7); JuLC rejects ('Undefined variable: c').
note: ADR-067 M1: JULC0074 (D1); REJECT none at the base.
---
import java.math.BigInteger;

public class Probe {
    sealed interface T permits C, D {}
    record C(BigInteger w) implements T {}
    record D(BigInteger w) implements T {}
    sealed interface U permits P, Q {}
    record P(T t) implements U {}
    record Q(BigInteger z) implements U {}

    public static BigInteger m(BigInteger a) {
        U u = new P(new C(a));
        return switch (u) {
            case P p when p.t() instanceof C c -> c.w();
            case P p -> BigInteger.ONE;
            case Q q -> q.z();
        };
    }
}
