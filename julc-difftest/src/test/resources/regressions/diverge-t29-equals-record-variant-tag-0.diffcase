format: 3
name: equals between a record and a tag-0 variant (E2, T29)
class: Probe
method: m
tag: Probe$A Probe$S 0
tag: Probe$B Probe$S 1
arg: 05
expect: REJECT JULC0078
note: ADR-067 E2.
note: ADR-068 M6: on the only frontend, javac, REJECT JULC0078; the JavaParser frontend answered DIVERGE T29 Value/Value.
---
import java.math.BigInteger;

public class Probe {
    record R1(BigInteger x) {}
    record R2(BigInteger x) {}
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}

    public static BigInteger m(BigInteger a) {
        return new R1(a).equals(new A(a)) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
