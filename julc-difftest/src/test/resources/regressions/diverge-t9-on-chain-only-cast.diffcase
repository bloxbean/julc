format: 2
name: AddressLib.credentialHash casts a PubKeyHash to byte[] (T9)
class: Probe
method: m
arg: 581c00000000000000000000000000000000000000000000000000000000
expect: DIVERGE T9 Failure/Value
jvm: Failure []
uplc: Value 581c00000000000000000000000000000000000000000000000000000000 []
note: The JVM throws ClassCastException; on-chain the cast is a no-op.
---
import java.math.BigInteger;
import org.julclang.core.types.JulcList;
import java.util.Optional;
import org.julclang.ledger.Address;
import org.julclang.ledger.Credential;
import org.julclang.ledger.PubKeyHash;
import org.julclang.stdlib.lib.AddressLib;

public class Probe {
    public static byte[] m(byte[] h) {
        Address address = new Address(new Credential.PubKeyCredential(new PubKeyHash(h)), Optional.empty());
        return AddressLib.credentialHash(address);
    }
}
