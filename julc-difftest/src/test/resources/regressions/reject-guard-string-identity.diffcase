format: 3
name: a guard comparing a non-constant String with == (F67, #289)
class: Probe
method: m
tag: Probe$A Probe$S 0
tag: Probe$B Probe$S 1
arg: 05
expect: REJECT JULC0072
note: ADR-067 review F67: Java compares identity (false, 2); JuLC compared values and returned 1 (#289). Non-constant String == is outside the guard subset.
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}

    public static BigInteger m(BigInteger a) {
        S s = new A(a);
        return switch (s) {
            case A x when (a + "b") == "5b" -> BigInteger.ONE;
            default -> BigInteger.TWO;
        };
    }
}
