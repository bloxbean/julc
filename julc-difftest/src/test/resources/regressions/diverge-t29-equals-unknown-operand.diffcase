format: 2
name: equals on an unknown operand that is disjoint in Java (D5u, T29)
class: Probe
method: m
arg: 05
arg: 06
expect: DIVERGE T29 Value/Value
jvm: Value 00 []
uplc: Value 01 []
note: ADR-067 D5u: retained divergence.
---
import java.math.BigInteger;

public class Probe {
    record R1(BigInteger x) {}
    record R2(BigInteger x) {}

    public static BigInteger m(BigInteger a, BigInteger b) {
        var x = a.signum() > 0 ? new R1(a) : new R1(b);
        return x.equals(new R2(a)) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
