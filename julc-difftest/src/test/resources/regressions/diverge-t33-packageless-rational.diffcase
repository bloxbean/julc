format: 2
name: #284 a packageless top-level record named like a ledger type (F19, T33)
class: Probe
method: m
arg: 05
arg: 07
expect: DIVERGE T33 Value/Value
jvm: Value 07 []
uplc: Value 05 []
note: ADR-067 F19.
---
import java.math.BigInteger;
record Rational(BigInteger denominator, BigInteger numerator) {}

public class Probe {

    public static BigInteger m(BigInteger a, BigInteger b) {
        Rational r = new Rational(a, b);
        return r.numerator();
    }
}
