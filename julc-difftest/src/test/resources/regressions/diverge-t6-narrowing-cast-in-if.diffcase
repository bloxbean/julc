format: 2
name: a narrowing cast of a long in an if (F72, T6)
class: Probe
method: m
arg: 1b0000000080000000
expect: AGREE
note: ADR-067 review F72, outside guards: (int) 2147483648L is negative in Java (2); JuLC erases the narrowing (1). ADR-062 T6.
note: ADR-068 M6: on the only frontend, javac, AGREE; the JavaParser frontend answered DIVERGE T6 Value/Value.
---
import java.math.BigInteger;

public class Probe {
    public static BigInteger m(long n) {
        if (((int) n) >= 0) {
            return BigInteger.ONE;
        }
        return BigInteger.TWO;
    }
}
