format: 3
name: a guard whose signum receiver is a traced call (F36, #146)
class: Probe
method: m
tag: Probe$A Probe$S 0
tag: Probe$B Probe$S 1
arg: 05
expect: AGREE
note: ADR-067 review F36, retained: signum evaluates a call receiver twice (#146), so the guard traces twice on-chain and once on the JVM. Values agree.
note: #146 (fixed): signum binds a receiver that is not a variable or a literal and evaluates it once, so the guard
note: traces once, as on the JVM; the expectation is AGREE and recorded.jvm and recorded.base keep the old pins.
recorded.jvm: Value 01 ["receiver"]
recorded.base: Value 01 ["receiver", "receiver"]
---
import java.math.BigInteger;
import org.julclang.stdlib.Builtins;

public class Probe {
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}
    static BigInteger said(BigInteger v) {
        return Builtins.unIData(Builtins.trace("receiver", Builtins.iData(v)));
    }

    public static BigInteger m(BigInteger a) {
        S s = new A(a);
        return switch (s) {
            case A x when said(x.v()).signum() > 0 -> BigInteger.ONE;
            default -> BigInteger.TWO;
        };
    }
}
