format: 2
name: a guard of type Boolean (F33, T27)
class: Probe
method: m
arg: 22
arg: 00
expect: DIVERGE T27 Value/Value
jvm: Value 02 []
uplc: Value 01 []
note: ADR-067 F33: a Boolean guard is legal Java (JLS 14.11.1).
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}
    static Boolean big(BigInteger x) { return x.compareTo(BigInteger.TEN) > 0; }

    public static BigInteger m(BigInteger a, BigInteger b) {
        S s = new A(a);
        return switch (s) {
            case A x when big(x.v()) -> BigInteger.ONE;
            case A x -> BigInteger.TWO;
            case B y -> BigInteger.ZERO;
        };
    }
}
