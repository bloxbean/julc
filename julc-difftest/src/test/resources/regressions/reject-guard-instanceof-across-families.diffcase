format: 3
name: guard instanceof on an operand cast to Object, target in another family (F51)
class: Probe
method: m
tag: Probe$A Probe$S 0
tag: Probe$B Probe$S 1
tag: Probe$C Probe$T 0
tag: Probe$D Probe$T 1
arg: 05
expect: REJECT JULC0072
note: ADR-067 review F51: Java returns 2 (an A is never a C). M1 compared tags across families and returned 1; the operand's family is now required.
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}
    sealed interface T permits C, D {}
    record C(BigInteger w) implements T {}
    record D(BigInteger w) implements T {}

    public static BigInteger m(BigInteger a) {
        S s = new A(a);
        return switch (s) {
            case A x when (Object) x instanceof C -> BigInteger.ONE;
            default -> BigInteger.TWO;
        };
    }
}
