format: 2
name: while nested in while with an inner local
class: Probe
method: m
arg: 05
expect: AGREE
---
import java.math.BigInteger;
import org.julclang.core.types.JulcList;

public class Probe {
    public static long m(long n) {
        long t = 0;
        long i = 0;
        while (i < n) {
            long j = 0;
            while (j < i) {
                t = t + j;
                j = j + 1;
            }
            i = i + 1;
        }
        return t;
    }
}
