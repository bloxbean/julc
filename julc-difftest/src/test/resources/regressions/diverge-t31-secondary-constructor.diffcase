import java.math.BigInteger;

public class Probe {
    record R(BigInteger x, BigInteger y) {
        R(BigInteger x) {
            this(x, BigInteger.TEN);
        }
    }

    public static BigInteger m(BigInteger a) {
        R r = new R(a);
        return r.y();
    }
}
