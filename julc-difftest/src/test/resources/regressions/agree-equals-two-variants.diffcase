format: 2
name: equals between two variants of one family (E5)
class: Probe
method: m
arg: 05
expect: AGREE
note: ADR-067 E5.
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}

    public static BigInteger m(BigInteger a) {
        return new A(a).equals(new B(a)) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
