format: 3
name: a direct assignment on a Data start
class: Case
method: m
arg: 01
arg: 00
expect: DIVERGE M5 Value/Failure
jvm: Value 00 []
uplc: Failure []
note: A direct assignment in a while is read as a list whatever the start, on both frontends, so this fails on entry. It fails closed.
---
import org.julclang.core.PlutusData;
import org.julclang.stdlib.Builtins;

public class Case {
    public static long m(PlutusData d, long limit) { PlutusData c = d; long n = 0; while (n < limit) { c = Builtins.mkNilData(); n = n + 1; } return n; }
}
