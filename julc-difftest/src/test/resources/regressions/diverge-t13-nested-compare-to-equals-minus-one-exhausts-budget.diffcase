import java.math.BigInteger;
import org.julclang.core.types.JulcList;

public class Probe {
    public static BigInteger m(BigInteger a, BigInteger b, JulcList<BigInteger> xs) {
        return ((((((((((((((((((((((((((a.compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b).compareTo(b) == -1 || b.compareTo(a) == -1) ? a : b);
    }
