format: 2
name: #284 the same with import org.julclang.ledger.*
class: Probe
method: m
arg: 05
arg: 07
expect: AGREE
note: ADR-067 F19b. A subset rule: no top-level type of the unnamed package takes a name of the ledger.
note: ADR-068 M6: on the only frontend, javac, AGREE; the JavaParser frontend answered REJECT JULC0100.
---
import java.math.BigInteger;
import org.julclang.ledger.*;
record Rational(BigInteger denominator, BigInteger numerator) {}

public class Probe {

    public static BigInteger m(BigInteger a, BigInteger b) {
        Rational r = new Rational(a, b);
        return r.numerator();
    }
}
