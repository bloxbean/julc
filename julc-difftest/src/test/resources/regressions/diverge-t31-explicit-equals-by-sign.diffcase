format: 2
name: #282 an explicit equals comparing by sign (H5, T31)
class: Probe
method: m
arg: 05
expect: DIVERGE T31 Value/Value
jvm: Value 01 []
uplc: Value 00 []
note: ADR-067 H5.
---
import java.math.BigInteger;

public class Probe {
    record P(BigInteger v) {
        public boolean equals(Object o) { return o instanceof P p && p.v().signum() == v.signum(); }
    }

    public static BigInteger m(BigInteger a) {
        return new P(a).equals(new P(a.add(BigInteger.ONE))) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
