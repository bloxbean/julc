format: 2
name: an escape in a string literal is not decoded (T22)
class: Probe
method: m
arg: 01
expect: DIVERGE T22 Value/Value
jvm: Value 01 ["a\n[TRACE] b"]
uplc: Value 01 ["a\\n[TRACE] b"]
note: Found by the trace-payload case (ADR-063 r4). PirGenerator lowers a StringLiteralExpr with
note: getValue(), JavaParser's source text with its escapes, instead of the decoded asString(), so the
note: script holds a backslash and an n where Java holds a line break.
---
import org.julclang.core.PlutusData;
import org.julclang.stdlib.Builtins;

public class Probe {
    public static PlutusData m(PlutusData n) {
        return Builtins.trace("a\n[TRACE] b", n);
    }
}
