format: 3
name: #279 equals across a record with two sealed parents (M6, T30)
class: Probe
method: m
tag: Probe$A Probe$S 0
tag: Probe$B Probe$S 1
tag: Probe$B Probe$T 0
tag: Probe$C Probe$T 1
arg: 05
expect: REJECT JULC0079
note: ADR-067 M6.
note: ADR-068 M6: on the only frontend, javac, REJECT JULC0079; the JavaParser frontend answered DIVERGE T30 Value/Value.
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, B {}
    sealed interface T permits B, C {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S, T {}
    record C(BigInteger v) implements T {}

    public static BigInteger m(BigInteger a) {
        S s = new B(a);
        return s.equals(new A(a)) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
