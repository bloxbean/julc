import java.math.BigInteger;
import org.julclang.core.types.JulcList;
import org.julclang.stdlib.Builtins;

public class Probe {

    static BigInteger t(String k, BigInteger v) {
        return Builtins.unIData(Builtins.trace(k, Builtins.iData(v)));
    }

    static BigInteger fail(BigInteger z) {
        return Builtins.unIData(Builtins.error());
    }

    static BigInteger v(BigInteger v) {
        return BigInteger.valueOf(-5);
    }

    static BigInteger w() {
        return t("k0", BigInteger.valueOf(-5));
    }

    public static BigInteger m(BigInteger a, BigInteger b, JulcList<BigInteger> xs) {
        return BigInteger.valueOf(-5);
    }
}
