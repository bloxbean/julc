format: 3
name: the G1 r1 #209 rejection reproducer with the shadowing local renamed apart agrees (counterfactual)
class: Probe
method: m
profile: G1 r1 -GUARDS -RECORD_PATTERNS -CROSS_TYPE_EQUALS -SHARED_VARIANT -ASSIGN_PATTERN_BINDING -ZERO_ARG_HELPERS +SHADOW_IN_LOOP_BRANCH -LOOP_BREAK_SHAPES -TRACE_IN_COMPARISON
arg: 06
arg: 03
arg: 9f02ff
expect: AGREE
note: ADR-066 D10.1 cause check for #209: the G1 campaign under REDISCOVER_209 found its reproducer rejected with
note: JULC0055 at every level (a branch local BigInteger f, shadowing the field R0 f in a loop body, keeps its type
note: for the read f.v() after the if). Renaming the local apart changes only the trigger; the JVM observation is
note: unchanged and UPLC agrees. Found under G1 r1, whose REDISCOVER_209 profile no longer gives this form in G1 r2 and later.
note: Provisional until #209 is fixed; the reproducer is recorded in ADR-066, M2 results.
---
import java.math.BigInteger;
import org.julclang.core.types.JulcList;
import org.julclang.stdlib.Builtins;

public class Probe {
    record R0(BigInteger v) {}

    static final R0 f = new R0(BigInteger.valueOf(-2).multiply(BigInteger.valueOf(2)));

    static BigInteger t(String k, BigInteger v) {
        return Builtins.unIData(Builtins.trace(k, Builtins.iData(v)));
    }

    static BigInteger fail(BigInteger z) {
        return Builtins.unIData(Builtins.error());
    }

    public static BigInteger m(BigInteger a, BigInteger b, JulcList<BigInteger> xs) {
        BigInteger w = t("k0", a);
        for (var w1 : xs) {
            w = BigInteger.valueOf(4);
            if (BigInteger.valueOf(-5).compareTo(BigInteger.valueOf(-5)) < 0) {
                BigInteger f1 = BigInteger.valueOf(-5);
                w = BigInteger.valueOf(-5);
            }
            w = f.v();
        }
        return BigInteger.valueOf(-5);
    }
}
