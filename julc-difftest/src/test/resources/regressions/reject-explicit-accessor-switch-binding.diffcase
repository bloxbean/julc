format: 3
name: #282 an explicit accessor called on a switch binding (T31)
class: Probe
method: m
tag: Probe$P Probe$SP 0
tag: Probe$Z Probe$SP 1
arg: 05
expect: DIVERGE T31 Value/Value
jvm: Value 24 []
uplc: Value 05 []
note: ADR-067 #282 (switch binding row of the issue).
---
import java.math.BigInteger;

public class Probe {
    sealed interface SP permits P, Z {}
    record P(BigInteger v) implements SP {
        public BigInteger v() { return v.negate(); }
    }
    record Z(BigInteger z) implements SP {}

    public static BigInteger m(BigInteger a) {
        SP sp = new P(a);
        return switch (sp) {
            case P p -> p.v();
            case Z z -> z.z();
        };
    }
}
