format: 2
name: two guarded arms with different binding names, then unguarded (G5, T27)
class: Probe
method: m
arg: 22
arg: 00
expect: DIVERGE T27 Value/Value
jvm: Value 22 []
uplc: Value 01 []
note: ADR-067 G5: both guards are false for a = -3, so Java returns the third arm, -3.
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}

    public static BigInteger m(BigInteger a, BigInteger b) {
        S s = new A(a);
        return switch (s) {
            case A x when x.v().signum() > 0 -> BigInteger.ONE;
            case A y when y.v().compareTo(BigInteger.valueOf(-10)) < 0 -> BigInteger.TWO;
            case A z -> z.v();
            case B w -> BigInteger.ZERO;
        };
    }
}
