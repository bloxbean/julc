format: 2
name: equals whose operand fails (E10)
class: Probe
method: m
arg: 05
expect: REJECT JULC0078
note: ADR-067 E10: both sides fail.
note: ADR-068 M6: on the only frontend, javac, REJECT JULC0078; the JavaParser frontend answered AGREE.
---
import java.math.BigInteger;

public class Probe {
    record R1(BigInteger x) {}
    record R2(BigInteger x) {}

    public static BigInteger m(BigInteger a) {
        return new R1(a).equals(new R2(a.divide(BigInteger.ZERO))) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
