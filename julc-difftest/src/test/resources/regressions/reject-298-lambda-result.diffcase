import java.math.BigInteger;
import org.julclang.core.types.JulcArray;
import org.julclang.core.types.JulcList;

public class Probe {

    public static long m(JulcList<BigInteger> xs) {
        var ys = xs.map(x -> JulcArray.of(x));
        return ys.size();
    }
}
