import java.math.BigInteger;
import org.julclang.core.types.JulcList;
import org.julclang.stdlib.Builtins;

public class Probe {
    record R0(BigInteger v, BigInteger w) {}
    record R1(BigInteger w, BigInteger v) {}

    static final R1 x = new R1(BigInteger.valueOf(-1), BigInteger.valueOf(2));

    static BigInteger t(String k, BigInteger v) {
        return Builtins.unIData(Builtins.trace(k, Builtins.iData(v)));
    }

    static BigInteger fail(BigInteger z) {
        return Builtins.unIData(Builtins.error());
    }

    public static R0 m(BigInteger a, BigInteger b, JulcList<BigInteger> xs) {
        R1 v = x;
        BigInteger f = x.w();
        long i0 = 0;
        while (i0 < 0) {
            R0 x = new R0(v.w(), BigInteger.valueOf(5));
            f = v.v();
            i0 = i0 + 1;
        }
        long i1 = 0;
        while (i1 < 3) {
            if (BigInteger.valueOf(-5).compareTo(BigInteger.valueOf(-5)) < 0) {
                R0 x = new R0(BigInteger.valueOf(-5), BigInteger.valueOf(-5));
                v = new R1(BigInteger.valueOf(-5), BigInteger.valueOf(-5));
            }
            f = x.w();
            v = new R1(BigInteger.valueOf(-5), BigInteger.valueOf(-5));
            v = new R1(BigInteger.valueOf(-5), BigInteger.valueOf(-5));
            i1 = i1 + 1;
        }
        return new R0(f, f);
    }
}
