format: 2
name: #282 an explicit equals comparing by sign (H5)
class: Probe
method: m
arg: 05
expect: REJECT JULC0101
note: ADR-067 H5. A subset rule: a method does not take a name read in place of its body.
---
import java.math.BigInteger;

public class Probe {
    record P(BigInteger v) {
        public boolean equals(Object o) { return o instanceof P p && p.v().signum() == v.signum(); }
    }

    public static BigInteger m(BigInteger a) {
        return new P(a).equals(new P(a.add(BigInteger.ONE))) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
