format: 3
name: an element of a mapped list, in a declared loop variable, carried in a tuple
class: Case
method: m
arg: 820102
expect: AGREE
note: A variable holds one type, so a tuple of accumulators encodes what was decoded.
note: ADR-068 D13: on frontend=JAVAC this agrees with the JVM (Adr068SavedCasesOnJavacTest).
---
import java.math.BigInteger;
import org.julclang.core.PlutusData;
import org.julclang.core.types.JulcList;
import org.julclang.stdlib.Builtins;

public class Case {
    public static long m(JulcList<BigInteger> xs) { long s = 0; for (BigInteger x : xs.map(q -> q)) { var y = x; long n = 0; for (var u : xs.map(q -> q)) { n = n + 1; y = u; } s = s + n; } return s; }
}
