format: 2
name: continue is outside the subset
class: Probe
method: m
arg: 83012103
expect: REJECT JULC0060
note: Rejected with JULC0060 ('continue is not supported on-chain'). Before #257 the diagnostic was
note: 'Unsupported statement: ContinueStmt', with no code (ADR-062 T20).
---
import java.math.BigInteger;
import org.julclang.core.types.JulcList;

public class Probe {
    public static BigInteger m(JulcList<BigInteger> xs) {
        BigInteger total = BigInteger.ZERO;
        for (var x : xs) {
            if (x.signum() < 0) { continue; }
            total = total.add(x);
        }
        return total;
    }
}
