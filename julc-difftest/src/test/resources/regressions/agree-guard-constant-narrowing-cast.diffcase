format: 3
name: a constant guard narrowing a long constant (round 3)
class: Probe
method: m
tag: Probe$A Probe$S 0
tag: Probe$B Probe$S 1
arg: 05
expect: AGREE
note: ADR-067 M1 round 3 (Codex): the cast of a constant is converted exactly (constant true).
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}

    public static BigInteger m(BigInteger a) {
        S s = new A(a);
        return switch (s) {
            case A x when ((int) 2147483648L) < 0 -> BigInteger.ONE;
            default -> BigInteger.TWO;
        };
    }
}
