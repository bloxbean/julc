format: 2
name: a guarded arm followed by default (G3, T27)
class: Probe
method: m
arg: 22
arg: 00
expect: DIVERGE T27 Value/Value
jvm: Value 02 []
uplc: Value 01 []
note: ADR-067 G3: the false guard falls to default in Java.
---
import java.math.BigInteger;

public class Probe {
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}

    public static BigInteger m(BigInteger a, BigInteger b) {
        S s = new A(a);
        return switch (s) {
            case A x when x.v().compareTo(BigInteger.TEN) > 0 -> BigInteger.ONE;
            default -> BigInteger.TWO;
        };
    }
}
