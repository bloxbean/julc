import java.math.BigInteger;
import org.julclang.core.types.JulcList;
import org.julclang.stdlib.Builtins;

public class Probe {
    record R1(BigInteger w, BigInteger v) {}
    sealed interface S0 permits B0, A0 {}
    record B0() implements S0 {}
    record A0() implements S0 {}
    record R0(BigInteger v, BigInteger w) {}

    static final R0 v = new R0(BigInteger.valueOf(1), BigInteger.valueOf(-2));
    static final R0 p = v;

    static BigInteger t(String k, BigInteger v) {
        return Builtins.unIData(Builtins.trace(k, Builtins.iData(v)));
    }

    static BigInteger fail(BigInteger z) {
        return Builtins.unIData(Builtins.error());
    }

    public static BigInteger m(BigInteger a, BigInteger b, JulcList<BigInteger> xs, R0 v) {
        S0 v1 = (b.compareTo(a) < 0 ? new B0() : new B0());
        BigInteger v2 = switch (v1) {
            case A0 v3 -> {
                A0 v4 = v3;
                long i0 = 0;
                while (i0 < 0) {
                    v4 = new A0();
                    i0 = i0 + 1;
                }
                yield BigInteger.valueOf(-5);
            }
            default -> {
                R1 p = new R1(BigInteger.valueOf(-5), BigInteger.valueOf(-5));
                BigInteger v5 = BigInteger.valueOf(-5);
                long i1 = 0;
                while (i1 < 0) {
                    v5 = BigInteger.valueOf(-5);
                    i1 = i1 + 1;
                }
                yield BigInteger.valueOf(-5);
            }
        };
        return p.v();
    }
}
