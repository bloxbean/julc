format: 2
name: equals of Optional of different record types (F16d, T29)
class: Probe
method: m
arg: 05
expect: REJECT JULC0087
note: ADR-067 F16d: retained divergence.
note: ADR-068 M6: on the only frontend, javac, REJECT JULC0087; the JavaParser frontend answered DIVERGE T29 Value/Value.
---
import java.math.BigInteger;
import java.util.Optional;

public class Probe {
    record R1(BigInteger x) {}
    record R2(BigInteger x) {}

    public static BigInteger m(BigInteger a) {
        return Optional.of(new R1(a)).equals(Optional.of(new R2(a))) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
