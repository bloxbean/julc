import java.math.BigInteger;
import org.julclang.core.types.JulcList;
import org.julclang.core.types.Tuple2;

public class Probe {

    public static long m(JulcList<BigInteger> xs) {
        var a = xs.toArray();
        var t = new Tuple2<>(a, a);
        return 1;
    }
}
