import java.math.BigInteger;
import org.julclang.core.types.JulcArray;
import org.julclang.core.types.JulcList;

public class Probe {

    public static BigInteger m(JulcList<BigInteger> xs) {
        JulcList<JulcArray<BigInteger>> arrays = JulcList.of(xs.toArray());
        return BigInteger.valueOf(arrays.head().length());
    }
}
