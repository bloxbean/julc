format: 3
name: equals between a record and a tag-1 variant (E3)
class: Probe
method: m
tag: Probe$A Probe$S 0
tag: Probe$B Probe$S 1
arg: 05
expect: AGREE
note: ADR-067 E3: already false on-chain.
---
import java.math.BigInteger;

public class Probe {
    record R1(BigInteger x) {}
    record R2(BigInteger x) {}
    sealed interface S permits A, B {}
    record A(BigInteger v) implements S {}
    record B(BigInteger v) implements S {}

    public static BigInteger m(BigInteger a) {
        return new R1(a).equals(new B(a)) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
