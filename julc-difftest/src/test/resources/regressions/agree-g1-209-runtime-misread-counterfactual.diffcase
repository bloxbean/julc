    }

    static BigInteger fail(BigInteger z) {
        return Builtins.unIData(Builtins.error());
    }

    public static R0 m(BigInteger a, BigInteger b, JulcList<BigInteger> xs) {
        BigInteger w = BigInteger.valueOf(-5);
        long i0 = 0;
        while (i0 < 1) {
            if (BigInteger.valueOf(-5).compareTo(BigInteger.valueOf(-5)) < 0) {
                R1 v1 = new R1(BigInteger.valueOf(-5), BigInteger.valueOf(-5).compareTo(BigInteger.valueOf(-5)) < 0);
                w = BigInteger.valueOf(-5);
            }
            w = v.w();
            i0 = i0 + 1;
        }
        return new R0(w.compareTo(w) < 0, w);
    }
}
