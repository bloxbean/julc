format: 2
name: a lambda parameter written var
class: Case
method: m
arg: 9f01ff
expect: REJECT JULC0055
note: The reference types a var lambda parameter as Data and cannot resolve signum; javac gives it the element's type (M5a section 12), accepted by decision (r13).
note: ADR-068 D13: on frontend=JAVAC this agrees with the JVM (Adr068SavedCasesOnJavacTest).
---
import java.math.BigInteger;
import org.julclang.core.PlutusData;
import org.julclang.core.types.JulcList;
import org.julclang.stdlib.annotation.NewType;

public class Case {
    public static boolean m(JulcList<BigInteger> xs) { return xs.any((var x) -> x.signum() > 0); }
}
