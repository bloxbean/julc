import java.math.BigInteger;
import org.julclang.core.types.JulcList;
import org.julclang.core.types.JulcMap;

public class Probe {

    public static long m(JulcList<BigInteger> xs) {
        var a = xs.toArray();
        var map = JulcMap.<org.julclang.core.types.JulcArray<BigInteger>, BigInteger>empty().insert(a, BigInteger.ONE);
        return map.size();
    }
}
