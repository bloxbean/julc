format: 2
name: #282 an explicit equals that is always true (T31)
class: Probe
method: m
arg: 05
expect: REJECT JULC0080
note: ADR-067 #282. A subset rule: a method does not take a name read in place of its body.
note: ADR-068 M6: on the only frontend, javac, REJECT JULC0080; the JavaParser frontend answered REJECT JULC0101.
---
import java.math.BigInteger;

public class Probe {
    record P(BigInteger v) {
        public boolean equals(Object o) { return true; }
    }

    public static BigInteger m(BigInteger a) {
        return new P(a).equals(new P(a.add(BigInteger.ONE))) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
