format: 2
name: A field of another type holds only a constant
class: Probe
method: m
arg: 05
expect: REJECT JULC0095
note: A subset rule: what is not lowered holds only a constant.
---
import java.math.BigInteger;

public class Probe {
    static class Nested {
        static final BigInteger K = BigInteger.valueOf(1);
    }

    public static BigInteger m(BigInteger a) {
        return a;
    }
}
