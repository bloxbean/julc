format: 3
name: a list cursor beside a map cursor
class: Case
method: m
arg: a201020304
arg: 83010203
expect: DIVERGE M5 Value/Failure
jvm: Value 02 []
uplc: Failure []
note: Beside a map cursor a direct tailList is read as a pair list, on both frontends, so a list there fails. It fails closed.
---
import java.math.BigInteger;
import org.julclang.core.PlutusData;
import org.julclang.core.types.JulcList;
import org.julclang.stdlib.Builtins;

public class Case {
    public static long m(PlutusData d, PlutusData e) { PlutusData c = Builtins.unMapData(d); PlutusData f = Builtins.unListData(e); long s = 0; while (!Builtins.nullList(c)) { s = s + 1; c = Builtins.tailList(c); f = Builtins.tailList(f); } return s; }
}
