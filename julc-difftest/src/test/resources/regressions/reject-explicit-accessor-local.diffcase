format: 2
name: #282 an explicit accessor called on a local (R6)
class: Probe
method: m
arg: 05
expect: REJECT JULC0101
note: ADR-067 R6. A subset rule: a method does not take a name read in place of its body.
---
import java.math.BigInteger;

public class Probe {
    record P(BigInteger v) {
        public BigInteger v() { return v.negate(); }
    }

    public static BigInteger m(BigInteger a) {
        P p = new P(a);
        return p.v();
    }
}
