format: 2
name: #282 an explicit accessor called on a local (R6, T31)
class: Probe
method: m
arg: 05
expect: DIVERGE T31 Value/Value
jvm: Value 24 []
uplc: Value 05 []
note: ADR-067 R6.
---
import java.math.BigInteger;

public class Probe {
    record P(BigInteger v) {
        public BigInteger v() { return v.negate(); }
    }

    public static BigInteger m(BigInteger a) {
        P p = new P(a);
        return p.v();
    }
}
