format: 2
name: equals between a record and PlutusData Constr 0 [a] (E7, T29)
class: Probe
method: m
arg: 05
expect: DIVERGE T29 Value/Value
jvm: Value 00 []
uplc: Value 01 []
note: ADR-067 E7.
---
import java.math.BigInteger;
import org.julclang.core.PlutusData;
import org.julclang.stdlib.Builtins;

public class Probe {
    record R1(BigInteger x) {}
    record R2(BigInteger x) {}

    public static BigInteger m(BigInteger a) {
        PlutusData d = Builtins.constrData(0, Builtins.mkCons(Builtins.iData(a), Builtins.mkNilData()));
        return new R1(a).equals(d) ? BigInteger.ONE : BigInteger.ZERO;
    }
}
