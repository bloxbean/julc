format: 3
name: a ledger hash from Data read as its bytes
class: Case
method: m
arg: 4401020304
expect: DIVERGE M5 Value/Failure
jvm: Value 04 []
uplc: Failure []
note: The reference reads a ledger hash's fromPlutusData as an identity, so the hash stays Data where bytes are read. Closed by M5.
note: ADR-068 D13: on frontend=JAVAC this agrees with the JVM (Adr068SavedCasesOnJavacTest).
---
import org.julclang.core.PlutusData;
import org.julclang.ledger.PubKeyHash;

public class Case {
    public static long m(PlutusData d) { return PubKeyHash.fromPlutusData(d).hash().length; }
}
