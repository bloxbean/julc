import java.math.BigInteger;
import org.julclang.core.types.JulcList;

public class Probe {
    public static BigInteger m(BigInteger a, BigInteger b, JulcList<BigInteger> xs) {
        return ((((((((((((((((((((((((((a.compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b).compareTo(b) < 0 || b.compareTo(a) < 0) ? a : b);
    }
}
