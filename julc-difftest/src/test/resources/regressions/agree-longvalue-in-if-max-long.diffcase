format: 2
name: longValue() at Long.MAX_VALUE in an if (F81, #294)
class: Probe
method: m
arg: 1b7fffffffffffffff
expect: AGREE
note: ADR-067 M1 round 4, F81 (#294), outside guards: JuLC lowers longValue() to the identity; at 9223372036854775807 Java does not narrow either (2).
---
import java.math.BigInteger;

public class Probe {
    public static BigInteger m(BigInteger a) {
        if (a.longValue() < 0) {
            return BigInteger.ONE;
        }
        return BigInteger.TWO;
    }
}
